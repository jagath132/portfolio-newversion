# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: The passcode required to save edits on the Admin Dashboard
ADMIN_PASSCODE="admin"

# WEB3FORMS_ACCESS_KEY: Key for sending contact form emails via Web3Forms
WEB3FORMS_ACCESS_KEY="98039fb8-4525-4f44-968a-3912eb290b21"
VITE_WEB3FORMS_ACCESS_KEY="98039fb8-4525-4f44-968a-3912eb290b21"
